#!/usr/bin/env bash
#
# Local gate before anything leaves this machine.
#
# The gates also run in CI, in .github/workflows/gates.yml, on every push and
# pull request. This hook runs the same checks before anything leaves this
# machine: the local half, before the push even reaches CI.
#
# Install (once):  git config core.hooksPath .githooks
# Skip (rarely):   git push --no-verify

set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1

pass=0
fail=0

step() {
  local name="$1"
  shift
  printf '  %-44s' "$name"
  if out=$(eval "$@" 2>&1); then
    printf 'ok\n'
    pass=$((pass + 1))
  else
    printf 'FAIL\n'
    printf '%s\n' "$out" | sed 's/^/      /'
    fail=$((fail + 1))
  fi
}

echo "pre-push gate"
step "shellcheck install.sh" "./scripts/shell-lint.sh"
step "gateway binds loopback by default" "./scripts/closed-by-default.sh"
step "fails before doing half the job" "./scripts/fail-before-half-the-job.sh"
step "manifest matches what this installs" "./scripts/manifest-is-true.sh"
step "record reads the bus, writes elsewhere" "./scripts/record-is-not-on-the-bus.sh"
# Reaches the network (a tarball from the sibling repo), which is why it is
# last: everything that can be judged offline has already spoken by here.
step "every image has the files it copies" "./scripts/build-context-complete.sh"

echo
if [ "$fail" -ne 0 ]; then
  echo "pre-push: $fail of $((pass + fail)) checks failed. Nothing pushed."
  exit 1
fi
echo "pre-push: all $pass checks passed."
