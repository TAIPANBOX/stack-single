#!/usr/bin/env bash
#
# Local gate before anything leaves this machine.
#
# The gates also run in CI, in .github/workflows/gates.yml, on every push and
# pull request. This hook runs the same checks before anything leaves this
# machine: the local half, before the push even reaches CI.
#
# Install (once):  git config core.hooksPath .githooks
# Skip (rarely):   git push --no-verify

set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1

pass=0
fail=0

step() {
  local name="$1"
  shift
  printf '  %-44s' "$name"
  if out=$(eval "$@" 2>&1); then
    printf 'ok\n'
    pass=$((pass + 1))
  else
    printf 'FAIL\n'
    printf '%s\n' "$out" | sed 's/^/      /'
    fail=$((fail + 1))
  fi
}

echo "pre-push gate"
step "shellcheck install.sh" "./scripts/shell-lint.sh"
step "gateway binds loopback by default" "./scripts/closed-by-default.sh"
step "fails before doing half the job" "./scripts/fail-before-half-the-job.sh"
step "manifest matches what this installs" "./scripts/manifest-is-true.sh"
step "record reads the bus, writes elsewhere" "./scripts/record-is-not-on-the-bus.sh"
step "the bus has a writer, every volume an owner" "./scripts/bus-has-a-writer.sh"
step "the operator's bind is honoured end to end" "./scripts/bind-is-honoured.sh"
step "the package step never takes Docker away" "./scripts/apt-never-removes-docker.sh"
step "the gateway's semantic cache is off" "./scripts/gateway-cache-is-off.sh"
step "the gateway's declassify key is minted per install" "./scripts/declassify-is-keyed.sh"
step "every gateway clamps a run's budget" "./scripts/run-budget-ceiling.sh"
step "the chain verifier writes only its own stream" "./scripts/chain-verifier-is-contained.sh"
step "every stream file is one the readers accept" "./scripts/bus-names-match-their-source.sh"
step "delegation is off by default" "./scripts/delegation-off-by-default.sh"
step "the delegation plane's keys are never printed" "./scripts/delegation-key-not-printed.sh"
step "the delegation plane's directories stay apart" "./scripts/delegation-dirs-are-split.sh"
step "Felyx reaches its model through the gateway" "./scripts/felyx-through-the-gateway.sh"
step ".env sources cleanly" "./scripts/env-sources-cleanly.sh"
step "the delegation plane's keys are reused on a re-run" "./scripts/delegation-key-reused-on-rerun.sh"
step "typed answers go where the operator chose" "./scripts/typed-data-mode.sh"
step "the typed risk signal is off unless asked" "./scripts/typed-risk-signal.sh"
step "the FinOps console is an add-on, core unchanged" "./scripts/finops-is-opt-in.sh"
step "no quote of the owner in a public file" "./scripts/no-owner-quotes.sh"
step "every scenario is bound to a test" "./scripts/features-are-bound.sh"
# Reaches the network (a tarball from the sibling repo), which is why it is
# last: everything that can be judged offline has already spoken by here.
step "every image has the files it copies" "./scripts/build-context-complete.sh"

echo
if [ "$fail" -ne 0 ]; then
  echo "pre-push: $fail of $((pass + fail)) checks failed. Nothing pushed."
  exit 1
fi
echo "pre-push: all $pass checks passed."
